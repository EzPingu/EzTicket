{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EzTicket Manager",
  "version": "../package.json",
  "identifier": "com.ezticket.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EzTicket Manager",
        "width": 1320,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https: http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3QTQ3QkE5ODk3MTA4REUKUldUZUNIR0pxWHVrNTZ6MDRlME9wSnVOempjck53QUM0OVZTREIzclJXY21VQjdoN0JFNTdoL2kK",
      "endpoints": [
        "https://github.com/EzPingu/EzTicket/releases/latest/download/latest.json"
      ],
      "installMode": "passive"
    }
  }
}
