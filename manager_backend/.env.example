DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
DISCORD_BOT_TOKEN=

# Manager release policy
MANAGER_CURRENT_VERSION=0.1.0
MANAGER_MINIMUM_VERSION=0.1.0
